# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection URI)
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/applyflow?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated for multiple origins)
# For local dev: http://localhost:5173
# For production: add your Netlify deployed site URL (e.g. https://applyflow-tracker.netlify.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
